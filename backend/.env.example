# Documentation only: Spring Boot does NOT automatically load .env files.
# Set these as environment variables in PowerShell or your IDE.
DB_URL=jdbc:mysql://localhost:3306/memory_recall?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# Current local Workbench account. Use a dedicated limited account for deployment.
DB_USERNAME=root
DB_PASSWORD=
# Base64-encoded cryptographically random key, at least 32 decoded bytes.
JWT_SECRET=
JWT_ISSUER=memory-recall-backend
JWT_TTL_SECONDS=1800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SERVER_PORT=8080
# Free-tier key from Google AI Studio. Keep this server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Cloudflare R2 object storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
